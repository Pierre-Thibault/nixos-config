+/* Build a human-readable label from the level bitmask:
+ * bit 0 = Shift (level 2), bit 1 = AltGr (level 3), bit 2 = level 5. */
+static char *
+level_label (int level)
+{
+	GString *str = g_string_new (NULL);
+
+	if (level == 0)
+		return g_string_free (g_string_append (str, "Base"), FALSE);
+	if (level & 1)
+		g_string_append (str, "Maj");
+	if (level & 2)
+		g_string_append_printf (str, "%sAltGr", str->len ? "+" : "");
+	if (level & 4)
+		g_string_append_printf (str, "%sNiv5", str->len ? "+" : "");
+
+	return g_string_free (str, FALSE);
+}
+
 static void
 num_levels_notify_cb (TeclaView  *view,
 		      GParamSpec *pspec,
